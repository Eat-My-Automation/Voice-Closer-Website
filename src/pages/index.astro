<script is:inline src="https://embed.cloudflarestream.com/embed/sdk.latest.js"></script>

<script is:inline>
  // Cloudflare Stream → PostHog event tracking
  (function() {
    function wireStream(elId, label) {
      const el = document.getElementById(elId);
      if (!el || typeof Stream !== 'function') return;
      const player = Stream(el);
      const milestonesHit = new Set();
      let duration = 0;

      player.addEventListener('loadedmetadata', () => { duration = player.duration || 0; });
      player.addEventListener('play', () => {
        if (window.posthog) posthog.capture('demo_video_played', { placement: label });
      });
      player.addEventListener('pause', () => {
        if (window.posthog) posthog.capture('demo_video_paused', { placement: label, at: Math.round(player.currentTime || 0) });
      });
      player.addEventListener('ended', () => {
        if (window.posthog) posthog.capture('demo_video_completed', { placement: label });
      });
      player.addEventListener('timeupdate', () => {
        if (!duration) return;
        const pct = (player.currentTime / duration) * 100;
        [25, 50, 75].forEach(m => {
          if (pct >= m && !milestonesHit.has(m)) {
            milestonesHit.add(m);
            if (window.posthog) posthog.capture('demo_video_progress', { placement: label, percent: m });
          }
        });
      });
    }

    // Re-run after the Cloudflare SDK loads (script is async by default)
    function init() {
      wireStream('hero-stream', 'hero');
      wireStream('section-stream', 'section');
    }
    if (typeof Stream === 'function') init();
    else window.addEventListener('load', init);
  })();
</script>

<script is:inline>
  // FAQ accordion
  document.querySelectorAll('.faq-question').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.parentElement;
      const answer = item.querySelector('.faq-answer');
      const isOpen = item.classList.contains('open');

      document.querySelectorAll('.faq-item').forEach(i => {
        i.classList.remove('open');
        i.querySelector('.faq-answer').style.maxHeight = null;
        i.querySelector('.faq-question').setAttribute('aria-expanded', 'false');
      });

      if (!isOpen) {
        item.classList.add('open');
        answer.style.maxHeight = answer.scrollHeight + 'px';
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });

  // Phone number auto-formatting: (267) 625-7559
  function formatPhone(value) {
    const digits = value.replace(/\D/g, '').slice(0, 10);
    if (digits.length === 0) return '';
    if (digits.length <= 3) return `(${digits}`;
    if (digits.length <= 6) return `(${digits.slice(0,3)}) ${digits.slice(3)}`;
    return `(${digits.slice(0,3)}) ${digits.slice(3,6)}-${digits.slice(6)}`;
  }

  // Strip formatting for API submission
  function stripPhone(value) {
    return value.replace(/\D/g, '');
  }

  // Demo call forms
  (function() {
    document.querySelectorAll('.demo-form').forEach(form => {
      const phoneInput = form.querySelector('input[name="phone"]');
      const nameField = form.querySelector('.demo-name-field');
      const revealed = form.querySelector('.demo-revealed');
      const consentCallBox = form.querySelector('input[name="consent_call"]');
      const btn = form.querySelector('button[type="submit"]');

      // Inline error helpers — no native browser popups
      function getErrorEl(name) {
        return form.querySelector(`.demo-error[data-error-for="${name}"]`);
      }
      function getInputWrap(input) {
        return input.closest('.demo-input-wrap') || input.closest('.demo-checkbox-label') || input;
      }
      function setError(input, message) {
        getInputWrap(input).classList.add('is-invalid');
        const errorEl = getErrorEl(input.name);
        if (errorEl) {
          errorEl.textContent = message;
          errorEl.classList.add('visible');
        }
      }
      function clearError(input) {
        getInputWrap(input).classList.remove('is-invalid');
        const errorEl = getErrorEl(input.name);
        if (errorEl) {
          errorEl.textContent = '';
          errorEl.classList.remove('visible');
        }
      }

      // Auto-format phone + reveal the rest of the form once they start typing
      phoneInput.addEventListener('input', () => {
        const cursor = phoneInput.selectionStart;
        const oldLen = phoneInput.value.length;
        phoneInput.value = formatPhone(phoneInput.value);
        const newLen = phoneInput.value.length;
        phoneInput.setSelectionRange(cursor + (newLen - oldLen), cursor + (newLen - oldLen));

        if (stripPhone(phoneInput.value).length > 0) {
          if (revealed) revealed.classList.add('visible');
        } else {
          if (revealed) revealed.classList.remove('visible');
        }
        clearError(phoneInput);
      });

      // Clear errors on the other fields as the user fixes them
      if (nameField) nameField.addEventListener('input', () => clearError(nameField));
      if (consentCallBox) consentCallBox.addEventListener('change', () => clearError(consentCallBox));

      // Reset form to initial state
      function resetForm(originalText) {
        btn.textContent = originalText;
        btn.style.background = '';
        btn.style.borderColor = '';
        btn.disabled = false;
        phoneInput.disabled = false;
        nameField.disabled = false;
      }

      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        // Manual validation — no reportValidity() / native popups.
        const phone = stripPhone(phoneInput.value);
        const name = (form.querySelector('input[name="name"]').value || '').trim();
        const consent_call = consentCallBox ? consentCallBox.checked : false;

        clearError(phoneInput);
        if (nameField) clearError(nameField);
        if (consentCallBox) clearError(consentCallBox);

        let firstInvalid = null;
        if (!phone || phone.length < 10) {
          setError(phoneInput, 'Enter a valid US or Canada mobile number.');
          firstInvalid = firstInvalid || phoneInput;
        }
        if (!name) {
          setError(nameField, 'Add your first name so the agent knows who to greet.');
          firstInvalid = firstInvalid || nameField;
        }
        if (!consent_call) {
          setError(consentCallBox, 'Tap to confirm you’re okay receiving the call.');
          firstInvalid = firstInvalid || consentCallBox;
        }
        if (firstInvalid) {
          if (typeof firstInvalid.focus === 'function') firstInvalid.focus({ preventScroll: true });
          return;
        }

        const consent_marketing = form.querySelector('input[name="consent_marketing"]')?.checked || false;

        const originalText = btn.textContent;
        btn.textContent = 'Calling you now...';
        btn.disabled = true;
        phoneInput.disabled = true;
        nameField.disabled = true;

        try {
          const res = await fetch('/api/test-call-homepage', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ phone, name, agent: 'voicecloser_homepage', consent_call, consent_marketing }),
          });

          const data = await res.json();

          if (data.success) {
            btn.textContent = 'Call incoming! Pick up your phone.';
            btn.style.background = '#34d399';
            btn.style.borderColor = '#34d399';
            // Reset after 15 seconds
            setTimeout(() => resetForm(originalText), 15000);
          } else {
            btn.textContent = data.error || 'Something went wrong. Try again.';
            btn.style.background = '#ef4444';
            btn.style.borderColor = '#ef4444';
            setTimeout(() => resetForm(originalText), 3000);
          }
        } catch (err) {
          btn.textContent = 'Connection error. Try again.';
          btn.style.background = '#ef4444';
          btn.style.borderColor = '#ef4444';
          setTimeout(() => resetForm(originalText), 3000);
        }
      });
    });
  })();
</script>

</Layout>
