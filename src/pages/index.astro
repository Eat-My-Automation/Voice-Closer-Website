          <span class="metric-label">Typical response time</span>
        </div>
      </div>
    </div>
  </section>
  -->


  <!-- ===== 8. CTA -BOOK A STRATEGY CALL ===== -->
  <section class="cta-band" id="book">
    <h2>See What This Would Look Like In Your Business.</h2>
    <p class="cta-band-sub">
      In 15 minutes, we'll map your call flow, show you the AI in action, and give you
      a clear price for your setup. If it's not a fit, we'll say so.
    </p>
    <ul class="cta-reassure">
      <li><span class="check">&#10003;</span> No long-term contracts</li>
      <li><span class="check">&#10003;</span> Use your existing number and CRM where possible</li>
      <li><span class="check">&#10003;</span> Straight answer on whether this will pay for itself</li>
    </ul>
    <a href="/book" class="btn btn-gold btn-lg">Book your 15-minute fit call</a>
    <p class="cta-band-secondary">
      <a href="#demo">Or have the AI call you first.</a>
    </p>
  </section>

  <!-- ===== 9. FAQ ===== -->
  <section class="faq-section" id="faq">
    <div class="container text-center">
      <h2 class="section-title">Frequently Asked Questions</h2>
      <span class="gold-line"></span>
    </div>

    <div class="faq-list">
      <div class="faq-item">
        <button class="faq-question" aria-expanded="false">
          <span>Does it handle inbound calls and new-lead follow-up?</span>
          <span class="faq-icon">+</span>
        </button>
        <div class="faq-answer">
          <div class="faq-answer-inner">
            Yes. VoiceCloser answers inbound calls live - no voicemail, no hold music.
            It also instantly calls back new leads the moment they come in from your web
            forms or ads, and logs every conversation into your CRM as a summary and
            follow-up task. All 24/7.
          </div>
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-question" aria-expanded="false">
          <span>Do I have to switch phone numbers?</span>
          <span class="faq-icon">+</span>
        </button>
        <div class="faq-answer">
          <div class="faq-answer-inner">
            No. You keep your existing business number. We set up simple call forwarding
            so VoiceCloser answers when you can't. Your customers never notice a difference.
          </div>
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-question" aria-expanded="false">
          <span>How long does setup take?</span>
          <span class="faq-icon">+</span>
        </button>
        <div class="faq-answer">
          <div class="faq-answer-inner">
            Most businesses are live within 3-5 business days. We handle the heavy
            lifting: scripting, testing, and configuration. All we need from you
            is one setup call and access to your lead list or CRM.
          </div>
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-question" aria-expanded="false">
          <span>What CRMs and calendars can you work with?</span>
          <span class="faq-icon">+</span>
        </button>
        <div class="faq-answer">
          <div class="faq-answer-inner">
            VoiceCloser integrates with most major CRMs (GoHighLevel, Follow Up Boss,
            HubSpot, Salesforce, and more) and calendar tools (Google Calendar, Calendly,
            Cal.com). If you use it, we can probably connect to it.
          </div>
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-question" aria-expanded="false">
          <span>What if the agent says something wrong?</span>
          <span class="faq-icon">+</span>
        </button>
        <div class="faq-answer">
          <div class="faq-answer-inner">
            Every agent is custom-trained on your business, services, and tone before
            going live. We test extensively and you approve the scripts. After launch,
            every call is logged and reviewed so we can continuously improve accuracy.
            You can update scripts or escalation rules at any time.
          </div>
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-question" aria-expanded="false">
          <span>How much does it cost?</span>
          <span class="faq-icon">+</span>
        </button>
        <div class="faq-answer">
          <div class="faq-answer-inner">
            Most clients invest <strong>$2,500-$4,000 one-time</strong> for the
            AI Receptionist &amp; Lead Handler setup, and <strong>from $500/month per
            location</strong> for ongoing call handling and support. Advanced AI Call
            Ops Assistant projects usually start at <strong>$3,000-$5,000</strong>
            for implementation, plus a monthly fee based on call volume. Exact pricing
            depends on your call volume, locations, and how deep we integrate with your
            CRM. We'll walk through it on your 15-minute fit call.
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== EXIT-INTENT MODAL (desktop: mouse-out to top; mobile: scroll into FAQ) ===== -->
  <div class="exit-modal-backdrop" id="exitModalBackdrop" aria-hidden="true"></div>
  <dialog id="exitModal" class="exit-modal" aria-labelledby="exitModalTitle">
    <button type="button" class="exit-modal-close" id="exitModalClose" aria-label="Close">&times;</button>
    <h2 id="exitModalTitle" class="exit-modal-title">Hear VoiceCloser in action</h2>
    <div class="exit-modal-video-wrap">
      <iframe
        id="exit-modal-stream"
        data-src={MODAL_VIDEO_SRC}
        title="VoiceCloser demo call"
        allow="accelerometer; autoplay; gyroscope; encrypted-media; picture-in-picture;"
        allowfullscreen
      ></iframe>
      <button type="button" class="exit-modal-unmute" id="exitModalUnmute" aria-label="Unmute video">
        <span class="exit-modal-unmute-icon" aria-hidden="true">&#128266;</span>
        <span>Tap for sound</span>
      </button>
    </div>
  </dialog>

<script is:inline src="https://embed.cloudflarestream.com/embed/sdk.latest.js"></script>

<script is:inline>
  // Cloudflare Stream → PostHog event tracking
  (function() {
    function wireStream(elId, label) {
      const el = document.getElementById(elId);
      if (!el || typeof Stream !== 'function') return;
      const player = Stream(el);
      const milestonesHit = new Set();
      let duration = 0;

      player.addEventListener('loadedmetadata', () => { duration = player.duration || 0; });
      player.addEventListener('play', () => {
        if (window.posthog) posthog.capture('demo_video_played', { placement: label });
        try { sessionStorage.setItem('demoVideoPlayed', '1'); } catch (_) {}
      });
      player.addEventListener('pause', () => {
        if (window.posthog) posthog.capture('demo_video_paused', { placement: label, at: Math.round(player.currentTime || 0) });
      });
      player.addEventListener('ended', () => {
        if (window.posthog) posthog.capture('demo_video_completed', { placement: label });
      });
      player.addEventListener('timeupdate', () => {
        if (!duration) return;
        const pct = (player.currentTime / duration) * 100;
        [25, 50, 75].forEach(m => {
          if (pct >= m && !milestonesHit.has(m)) {
            milestonesHit.add(m);
            if (window.posthog) posthog.capture('demo_video_progress', { placement: label, percent: m });
          }
        });
      });
    }

    // Re-run after the Cloudflare SDK loads (script is async by default)
    function init() {
      wireStream('section-stream', 'section');
    }
    if (typeof Stream === 'function') init();
    else window.addEventListener('load', init);
  })();
</script>

<script is:inline>
  // FAQ accordion
  document.querySelectorAll('.faq-question').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.parentElement;
      const answer = item.querySelector('.faq-answer');
      const isOpen = item.classList.contains('open');

      document.querySelectorAll('.faq-item').forEach(i => {
        i.classList.remove('open');
        i.querySelector('.faq-answer').style.maxHeight = null;
        i.querySelector('.faq-question').setAttribute('aria-expanded', 'false');
      });

      if (!isOpen) {
        item.classList.add('open');
        answer.style.maxHeight = answer.scrollHeight + 'px';
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });

  // Phone number auto-formatting: (267) 625-7559
  function formatPhone(value) {
    const digits = value.replace(/\D/g, '').slice(0, 10);
    if (digits.length === 0) return '';
    if (digits.length <= 3) return `(${digits}`;
    if (digits.length <= 6) return `(${digits.slice(0,3)}) ${digits.slice(3)}`;
    return `(${digits.slice(0,3)}) ${digits.slice(3,6)}-${digits.slice(6)}`;
  }

  // Strip formatting for API submission
  function stripPhone(value) {
    return value.replace(/\D/g, '');
  }

  // Demo call forms
  (function() {
    document.querySelectorAll('.demo-form').forEach(form => {
      const phoneInput = form.querySelector('input[name="phone"]');
      const nameField = form.querySelector('.demo-name-field');
      const revealed = form.querySelector('.demo-revealed');
      const consentCallBox = form.querySelector('input[name="consent_call"]');
      const btn = form.querySelector('button[type="submit"]');

      // Inline error helpers — no native browser popups
      function getErrorEl(name) {
        return form.querySelector(`.demo-error[data-error-for="${name}"]`);
      }
      function getInputWrap(input) {
        return input.closest('.demo-input-wrap') || input.closest('.demo-checkbox-label') || input;
      }
      function setError(input, message) {
        getInputWrap(input).classList.add('is-invalid');
        const errorEl = getErrorEl(input.name);
        if (errorEl) {
          errorEl.textContent = message;
          errorEl.classList.add('visible');
        }
      }
      function clearError(input) {
        getInputWrap(input).classList.remove('is-invalid');
        const errorEl = getErrorEl(input.name);
        if (errorEl) {
          errorEl.textContent = '';
          errorEl.classList.remove('visible');
        }
      }

      // Auto-format phone + reveal the rest of the form once they start typing
      phoneInput.addEventListener('input', () => {
        const cursor = phoneInput.selectionStart;
        const oldLen = phoneInput.value.length;
        phoneInput.value = formatPhone(phoneInput.value);
        const newLen = phoneInput.value.length;
        phoneInput.setSelectionRange(cursor + (newLen - oldLen), cursor + (newLen - oldLen));

        if (stripPhone(phoneInput.value).length > 0) {
          if (revealed) revealed.classList.add('visible');
        } else {
          if (revealed) revealed.classList.remove('visible');
        }
        clearError(phoneInput);
      });

      // Clear errors on the other fields as the user fixes them
      if (nameField) nameField.addEventListener('input', () => clearError(nameField));
      if (consentCallBox) consentCallBox.addEventListener('change', () => clearError(consentCallBox));

      // Reset form to initial state
      function resetForm(originalText) {
        btn.textContent = originalText;
        btn.style.background = '';
        btn.style.borderColor = '';
        btn.disabled = false;
        phoneInput.disabled = false;
        nameField.disabled = false;
      }

      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        // Manual validation — no reportValidity() / native popups.
        const phone = stripPhone(phoneInput.value);
        const name = (form.querySelector('input[name="name"]').value || '').trim();
        const consent_call = consentCallBox ? consentCallBox.checked : false;

        clearError(phoneInput);
        if (nameField) clearError(nameField);
        if (consentCallBox) clearError(consentCallBox);

        let firstInvalid = null;
        if (!phone || phone.length < 10) {
          setError(phoneInput, 'Enter a valid US or Canada mobile number.');
          firstInvalid = firstInvalid || phoneInput;
        }
        if (!name) {
          setError(nameField, 'Add your first name so the agent knows who to greet.');
          firstInvalid = firstInvalid || nameField;
        }
        if (!consent_call) {
          setError(consentCallBox, 'Tap to confirm you’re okay receiving the call.');
          firstInvalid = firstInvalid || consentCallBox;
        }
        if (firstInvalid) {
          if (typeof firstInvalid.focus === 'function') firstInvalid.focus({ preventScroll: true });
          return;
        }

        const consent_marketing = form.querySelector('input[name="consent_marketing"]')?.checked || false;

        const originalText = btn.textContent;
        btn.textContent = 'Calling you now...';
        btn.disabled = true;
        phoneInput.disabled = true;
        nameField.disabled = true;

        try {
          const res = await fetch('/api/test-call-homepage', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ phone, name, agent: 'voicecloser_homepage', consent_call, consent_marketing }),
          });

          const data = await res.json();

          if (data.success) {
            btn.textContent = 'Call incoming! Pick up your phone.';
            btn.style.background = '#34d399';
            btn.style.borderColor = '#34d399';
            try { sessionStorage.setItem('demoFormSubmitted', '1'); } catch (_) {}
            // Reset after 15 seconds
            setTimeout(() => resetForm(originalText), 15000);
          } else {
            btn.textContent = data.error || 'Something went wrong. Try again.';
            btn.style.background = '#ef4444';
            btn.style.borderColor = '#ef4444';
            setTimeout(() => resetForm(originalText), 3000);
          }
        } catch (err) {
          btn.textContent = 'Connection error. Try again.';
          btn.style.background = '#ef4444';
          btn.style.borderColor = '#ef4444';
          setTimeout(() => resetForm(originalText), 3000);
        }
      });
    });
  })();
</script>

<script is:inline>
  // Exit-intent modal — desktop: mouseout-top (after 15s + at least one scroll);
  // mobile: scroll into FAQ. Once per session. Suppressed if user already
  // played the demo, submitted the form, or is currently typing.
  (function() {
    const modal = document.getElementById('exitModal');
    if (!modal || typeof modal.show !== 'function') return;

    const backdrop = document.getElementById('exitModalBackdrop');
    const iframe = document.getElementById('exit-modal-stream');
    const closeBtn = document.getElementById('exitModalClose');
    const unmuteBtn = document.getElementById('exitModalUnmute');
    let player = null;

    // Desktop trigger gates: don't fire until both are true.
    let timeGateReady = false;
    let userScrolled = false;
    setTimeout(() => { timeGateReady = true; }, 15000);
    window.addEventListener('scroll', () => { userScrolled = true; }, { once: true, passive: true });

    function inSuppressedState() {
      try {
        if (sessionStorage.getItem('exitModalShown')) return true;
        if (sessionStorage.getItem('demoVideoPlayed')) return true;
        if (sessionStorage.getItem('demoFormSubmitted')) return true;
      } catch (_) {}
      const tag = (document.activeElement && document.activeElement.tagName) || '';
      if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return true;
      if (document.activeElement && document.activeElement.isContentEditable) return true;
      return false;
    }

    function meetsDesktopGates() {
      return timeGateReady && userScrolled;
    }

    function pauseInlineVideos() {
      if (typeof Stream !== 'function') return;
      ['section-stream'].forEach(id => {
        const el = document.getElementById(id);
        if (el) {
          try { Stream(el).pause(); } catch (_) {}
        }
      });
    }

    function openModal() {
      if (inSuppressedState()) return;
      try { sessionStorage.setItem('exitModalShown', '1'); } catch (_) {}

      // Lazy-load the iframe src so the video doesn't burn bandwidth on
      // visitors who never trigger the modal.
      if (iframe && !iframe.src && iframe.dataset.src) {
        iframe.src = iframe.dataset.src;
      }

      pauseInlineVideos();
      // Non-modal show() keeps the page interactive (scroll passthrough).
      // The dim backdrop is a separate div with pointer-events: none.
      modal.show();
      if (backdrop) backdrop.classList.add('visible');

      // Bind player handle now that the iframe has src. Stream() doesn't
      // require the iframe to be fully loaded - it just queues postMessage
      // calls until the iframe is ready.
      tryBindPlayer();

      if (window.posthog) posthog.capture('exit_modal_shown');
    }

    function closeModal() {
      if (player) {
        try { player.pause(); } catch (_) {}
      } else if (iframe) {
        // Fallback: clear src to fully stop playback if SDK never loaded.
        const stash = iframe.src;
        iframe.src = '';
        iframe.dataset.src = stash;
      }
      if (backdrop) backdrop.classList.remove('visible');
      modal.close();
    }

    closeBtn.addEventListener('click', closeModal);

    modal.addEventListener('close', () => {
      if (backdrop) backdrop.classList.remove('visible');
      if (player) {
        try { player.pause(); } catch (_) {}
      }
    });

    // ESC key — non-modal dialog doesn't auto-close on ESC, wire manually.
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.open) {
        e.preventDefault();
        closeModal();
      }
    });

    // Bind the Stream player handle. Safe to call multiple times - it's a
    // no-op once the player is set. Returns true if the player is bound.
    function tryBindPlayer() {
      if (player) return true;
      if (typeof Stream !== 'function' || !iframe || !iframe.src) return false;
      try { player = Stream(iframe); } catch (_) {}
      return !!player;
    }

    // Unmute button: try the Stream SDK first, fall back to reloading the
    // iframe with muted=false. The reload path is synchronous in response
    // to the user click, so the gesture context is preserved and Chrome /
    // Safari will allow autoplay-with-sound on the fresh iframe load.
    unmuteBtn.addEventListener('click', () => {
      let method = 'reload';

      // Lazy-bind in case the bind from openModal didn't take.
      if (tryBindPlayer() && player) {
        try {
          player.muted = false;
          player.volume = 1;
          player.play();
          method = 'sdk';
        } catch (_) {}
      }

      if (method === 'reload' && iframe && iframe.dataset.src) {
        // Fallback: reload the iframe with sound. Browser treats the
        // user click as the gesture for the new iframe load.
        iframe.src = iframe.dataset.src.replace('muted=true', 'muted=false');
      }

      unmuteBtn.classList.add('hidden');
      if (window.posthog) posthog.capture('exit_modal_unmuted', { method });
    });

    // ===== Triggers =====
    const isMobile = window.matchMedia('(max-width: 768px)').matches;

    if (!isMobile) {
      // Desktop: mouse leaves through top of viewport, but only after the
      // user has been on the page 15s AND scrolled at least once. This
      // prevents the misfire where a fresh visitor moves their mouse to
      // the URL bar before they've even read the hero.
      document.addEventListener('mouseout', (e) => {
        if (e.relatedTarget) return;          // moved into another element
        if (e.clientY > 0) return;            // not exiting through the top
        if (!meetsDesktopGates()) return;     // not engaged enough yet
        openModal();
      });
    } else {
      // Mobile: fired when FAQ section becomes substantially visible.
      // No time gate needed — scrolling to FAQ is itself a strong engagement signal.
      const faq = document.getElementById('faq');
      if (faq && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.intersectionRatio >= 0.6) {
              openModal();
              observer.disconnect();
            }
          });
        }, { threshold: [0.6] });
        observer.observe(faq);
      }
    }
  })();
</script>

