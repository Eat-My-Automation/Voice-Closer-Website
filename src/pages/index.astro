---
import Layout from '../layouts/Layout.astro';
const DEMO_VIDEO_UID = import.meta.env.PUBLIC_DEMO_VIDEO_UID;
const POSTER_URL = `https://videodelivery.net/${DEMO_VIDEO_UID}/thumbnails/thumbnail.jpg?time=26.4s`;
const POSTER_PARAM = encodeURIComponent(POSTER_URL);
const INLINE_VIDEO_SRC = `https://iframe.cloudflarestream.com/${DEMO_VIDEO_UID}?letterboxColor=%230a0f1e&poster=${POSTER_PARAM}`;
const MODAL_VIDEO_SRC = `https://iframe.cloudflarestream.com/${DEMO_VIDEO_UID}?autoplay=true&muted=true&controls=true&letterboxColor=%230a0f1e&poster=${POSTER_PARAM}`;
---
<Layout
  title="AI Voice Agents That Book Sales Calls For You"
  description="AI voice agents that call your leads, handle objections, and book appointments 24/7. Built for agencies and B2B teams that want more booked calls without hiring more reps."
>

  <!-- ===== 1. HERO -DEMO FIRST ===== -->
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-text">
        <h1>AI Receptionist &amp; Call Assistant That Answers Every Call</h1>
        <p class="hero-sub">
          VoiceCloser installs an AI phone agent into your existing number and CRM so you
          stop losing money to missed calls, slow follow-up, and forgotten tasks.
        </p>

        <ul class="hero-bullets">
          <li><span class="check">&#10003;</span><span>Answer and route every inbound call 24/7</span></li>
          <li><span class="check">&#10003;</span><span>Instantly follow up with new leads from web forms and paid ads</span></li>
          <li><span class="check">&#10003;</span><span>Call logs auto-summarized and turned into tasks inside your CRM</span></li>
        </ul>

        <div class="hero-links-row">
          <a href="#demo-video" class="hero-watch-link">See it handle a real call &#8594;</a>
        </div>
      </div>

      <div class="hero-form-col">
        <div class="demo-cta">
          <div class="demo-cta-eyecatch">
            <div class="phone-pulse">
              <div class="phone-pulse-icon">&#128222;</div>
            </div>
            <div class="demo-cta-eyecatch-text">
              Test it yourself
              <span>Don't take our word for it - hear it live</span>
            </div>
          </div>
          <form action="#" method="POST" id="heroDemoForm" class="demo-form" novalidate>
            <div class="demo-input-wrap demo-input-required">
              <input type="tel" name="phone" placeholder="Enter your mobile number" autocomplete="tel" />
            </div>
            <p class="demo-error" data-error-for="phone"></p>

            <div class="demo-revealed">
              <div class="demo-input-wrap demo-input-required">
                <input type="text" name="name" class="demo-name-field" placeholder="Your first name" autocomplete="given-name" />
              </div>
              <p class="demo-error" data-error-for="name"></p>

              <div class="demo-consent-fields">
                <label class="demo-checkbox-label">
                  <input type="checkbox" name="consent_call" />
                  <span>I agree to receive a phone call from an AI voice agent from RECO QA LLC (VoiceCloser). <span class="req">*</span></span>
                </label>
                <p class="demo-error" data-error-for="consent_call"></p>

                <label class="demo-checkbox-label">
                  <input type="checkbox" name="consent_marketing" />
                  <span>Optional: Also send me SMS follow-ups, tips, and offers from RECO QA LLC (VoiceCloser). Msg frequency varies. Msg &amp; data rates may apply. Reply STOP to stop, HELP for help.</span>
                </label>
                <p class="demo-consent-links"><a href="/privacy" target="_blank">Privacy Policy</a> &middot; <a href="/terms" target="_blank">Terms of Service</a></p>
              </div>
            </div>

            <button type="submit" class="btn btn-gold demo-submit">Call me right now</button>
          </form>
          <p class="demo-cta-helper">
            US &amp; Canada only.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== 2. PROBLEM SECTION ===== -->
  <section class="problem-section">
    <div class="problem-inner container">
      <div class="problem-text">
        <h2>Every Missed Call And Ignored Lead Costs You Money.</h2>
        <p>
          Your phone rings while you're on a job. A lead fills out a form at 9 PM.
          You promised three callers you'd follow up - and forgot two. Every one of
          those is revenue walking out the door.
        </p>
        <ul class="problem-list">
          <li>
            <span class="icon">&#10007;</span>
            <span>New leads hit voicemail and move on to the next business.</span>
          </li>
          <li>
            <span class="icon">&#10007;</span>
            <span>Existing customers feel ignored when no one picks up.</span>
          </li>
          <li>
            <span class="icon">&#10007;</span>
            <span>Promises made on calls slip through the cracks with no follow-up.</span>
          </li>
        </ul>
        <a href="#how-it-works" class="btn btn-outline btn-sm">See How VoiceCloser Fixes This</a>
      </div>

      <div class="comparison-card">
        <div class="comparison-side current">
          <div class="comparison-label">Current Reality</div>
          <div class="comparison-stat">
            <span class="stat-icon">&#128222;</span>
            <span class="stat-text">12 missed calls today<br/>5 promised callbacks forgotten</span>
          </div>
        </div>
        <div class="comparison-side better">
          <div class="comparison-label">With VoiceCloser</div>
          <div class="comparison-stat">
            <span class="stat-icon">&#9989;</span>
            <span class="stat-text">12 answered, 7 booked<br/>every call logged &amp; tasked</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== 3. THREE PILLARS ===== -->
  <section class="pillars-section">
    <div class="container text-center">
      <h2 class="section-title">One Voice Agent. Three Jobs You Hate Doing.</h2>
      <span class="gold-line"></span>
    </div>

    <div class="pillars-grid container">
      <div class="pillar-card">
        <div class="pillar-icon">&#10003;</div>
        <h3>Answer Every Call Live</h3>
        <p>
          Instantly answers every call with a professional, branded greeting so real
          people talk to a real-sounding agent instead of voicemail.
        </p>
      </div>
      <div class="pillar-card">
        <div class="pillar-icon">&#10003;</div>
        <h3>Qualify &amp; Route Serious Leads</h3>
        <p>
          Asks the right questions, filters tire-kickers, and emails you a summary
          of every serious lead or routes them to the right person.
        </p>
      </div>
      <div class="pillar-card">
        <div class="pillar-icon">&#10003;</div>
        <h3>Summarize Every Call Into CRM Tasks</h3>
        <p>
          Reads every call, writes a clean summary into your CRM, and creates the
          follow-up tasks automatically - so what gets said on the phone actually gets done.
        </p>
      </div>
    </div>

    <div class="container text-center mt-2">
      <a href="#demo-video" class="btn btn-outline">Watch A 60-Second Overview</a>
    </div>
  </section>

  <!-- ===== 3.5 SEE IT IN ACTION (DEMO VIDEO) ===== -->
  <section class="demo-video-section" id="demo-video">
    <div class="container text-center">
      <h2 class="section-title">See It In Action.</h2>
      <span class="gold-line"></span>
    </div>

    <div class="demo-video-wrap container">
      <div class="hero-video">
        <iframe
          id="section-stream"
          src={INLINE_VIDEO_SRC}
          class="hero-video-player"
          loading="lazy"
          title="VoiceCloser demo call"
          allow="accelerometer; gyroscope; encrypted-media; picture-in-picture;"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </section>

  <!-- ===== 4. HOW IT WORKS -3 STEPS ===== -->
  <section class="steps-section" id="how-it-works">
    <div class="container text-center">
      <h2 class="section-title">Here's How VoiceCloser Goes Live In Days, Not Months.</h2>
      <span class="gold-line"></span>
    </div>

    <div class="steps-grid container">
      <div class="step-card">
        <div class="step-number">1</div>
        <h3>Quick Setup Call</h3>
        <p>
          We learn how your business works, what to say, and who counts as a qualified lead.
        </p>
      </div>
      <div class="step-card">
        <div class="step-number">2</div>
        <h3>We Train Your Voice Agent</h3>
        <p>
          We configure scripts, booking rules, and test calls until you're happy with every word.
        </p>
      </div>
      <div class="step-card">
        <div class="step-number">3</div>
        <h3>Forward Your Phones &amp; Plug In Your Leads</h3>
        <p>
          We start answering inbound calls and calling through your existing database. You focus on closing.
        </p>
      </div>
    </div>

    <div class="steps-flow container">
      <div class="flow-box">Caller / Lead List</div>
      <span class="flow-arrow">&#8594;</span>
      <div class="flow-box" style="border-color: var(--gold);">VoiceCloser</div>
      <span class="flow-arrow">&#8594;</span>
      <div class="flow-box">Calendar / Inbox / CRM</div>
    </div>

    <div class="container text-center mt-2">
      <a href="/book" class="btn btn-gold btn-lg">Book A 15-Minute Strategy Call</a>
    </div>
  </section>

  <!-- ===== 5. TRY IT YOURSELF (DEMO BAND) ===== -->
  <section class="demo-band" id="demo">
    <h2>See Exactly How Your Customers Will Be Greeted.</h2>
    <div class="demo-cta">
      <div class="demo-cta-eyecatch" style="justify-content: center;">
        <div class="phone-pulse">
          <div class="phone-pulse-icon">&#128222;</div>
        </div>
        <div class="demo-cta-eyecatch-text">
          Try it live
          <span>Don't take our word for it - hear it live</span>
        </div>
      </div>
      <form action="#" method="POST" id="demoBandForm" class="demo-form" novalidate>
        <div class="demo-input-wrap demo-input-required">
          <input type="tel" name="phone" placeholder="Enter your mobile number" autocomplete="tel" />
        </div>
        <p class="demo-error" data-error-for="phone"></p>

        <div class="demo-revealed">
          <div class="demo-input-wrap demo-input-required">
            <input type="text" name="name" class="demo-name-field" placeholder="Your first name" autocomplete="given-name" />
          </div>
          <p class="demo-error" data-error-for="name"></p>

          <div class="demo-consent-fields">
            <label class="demo-checkbox-label">
              <input type="checkbox" name="consent_call" />
              <span>I agree to receive a phone call from an AI voice agent and related follow-up messages from RECO QA LLC (VoiceCloser). Msg &amp; data rates may apply. Reply STOP to stop, HELP for help. <span class="req">*</span></span>
            </label>
            <p class="demo-error" data-error-for="consent_call"></p>

            <label class="demo-checkbox-label">
              <input type="checkbox" name="consent_marketing" />
              <span>Also send me follow-up tips and offers from VoiceCloser via text. Msg frequency varies. Msg &amp; data rates may apply. Reply STOP to stop, HELP for help.</span>
            </label>
            <p class="demo-consent-links"><a href="/privacy" target="_blank">Privacy Policy</a> &middot; <a href="/terms" target="_blank">Terms of Service</a></p>
          </div>
        </div>

        <button type="submit" class="btn btn-gold demo-submit">Call me right now</button>
      </form>
      <p class="demo-cta-helper">
        US &amp; Canada only.
      </p>
    </div>
  </section>

  <!-- ===== 6. WHO IT'S FOR ===== -->
  <section class="audience-section" id="who-its-for">
    <div class="audience-inner container">
      <div class="audience-text">
        <h2>Built For Call-Heavy Businesses.</h2>
        <p>
          If your business lives or dies by phone conversations, whether that's
          booking appointments, qualifying leads, or following up on estimates,
          VoiceCloser was built for you.
        </p>
      </div>

      <ul class="audience-list">
        <li class="audience-pill">
          <span class="check">&#10003;</span>
          <span>Agencies &amp; marketing firms</span>
        </li>
        <li class="audience-pill">
          <span class="check">&#10003;</span>
          <span>Home services &amp; contractors</span>
        </li>
        <li class="audience-pill">
          <span class="check">&#10003;</span>
          <span>Real estate teams</span>
        </li>
        <li class="audience-pill">
          <span class="check">&#10003;</span>
          <span>Clinics &amp; appointment-based businesses</span>
        </li>
        <li class="audience-pill">
          <span class="check">&#10003;</span>
          <span>Any business that misses calls or sits on a big lead list</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- ===== 6.4 FOUNDER STORY ===== -->
  <section class="founder-section" id="why">
    <div class="founder-inner">
      <p class="founder-eyebrow">From the founder</p>
      <h2>Why I built VoiceCloser</h2>
      <div class="founder-body">
        <p>
          I spent 14 years in real estate as an agent and investor, closing hundreds of
          transactions and buying and selling over $18M in property.
        </p>
        <p>
          Here's what I learned about myself: my sales skills are top-notch, but my
          follow-up habits are <strong>terrible</strong>. I've left millions on the table
          by not putting callbacks in the calendar, getting overwhelmed, and letting deals
          slip over time.
        </p>
        <p>
          So I built VoiceCloser to fix my own weakness. It handles the calls you don't
          want to take, and backs you up on the ones you do.
        </p>
        <p>
          It answers and qualifies every inbound call, says the right thing at the right
          moment, and turns each conversation into a clear set of next actions.
        </p>
        <p>
          And when a call comes to you instead, it listens in, finds the contact in your
          CRM, and tells you exactly where you stand: what deals are open, the last few
          things you talked about. Then it does the part I always dropped. It lays out your
          next follow-up steps and actually does them: creates the opportunity, schedules
          the tasks, sets the appointment, and sends the calendar invite (if you're on
          GoHighLevel). You might forget. Your VoiceCloser won't.
        </p>
        <p>
          <strong>Sub-par sales skills with great follow-up will always beat great sales
          skills with sub-par follow-up.</strong> If you're burning out on the mundane,
          repetitive calls and CRM busywork, VoiceCloser was built for you.
        </p>
      </div>
    </div>
  </section>

  <!-- ===== 6.5 PRICING ===== -->
  <section class="pricing-section" id="pricing">
    <div class="container text-center">
      <h2 class="section-title">Simple, Transparent Pricing</h2>
      <span class="gold-line"></span>
      <p class="section-subtitle">You're replacing missed calls and admin work, not just buying another tool.</p>
    </div>

    <div class="pricing-grid container">
      <div class="pricing-card">
        <h3 class="pricing-name">AI Receptionist &amp; Lead Handler</h3>
        <p class="pricing-ideal">
          Call-heavy businesses that want every call answered and every new lead
          followed up automatically.
        </p>
        <ul class="pricing-includes">
          <li><span class="check">&#10003;</span><span>AI receptionist that answers and routes inbound calls</span></li>
          <li><span class="check">&#10003;</span><span>Instant callbacks for new web and paid leads</span></li>
          <li><span class="check">&#10003;</span><span>Appointment booking into your existing calendar</span></li>
          <li><span class="check">&#10003;</span><span>Basic CRM / GoHighLevel workflows wired for follow-up</span></li>
        </ul>
        <div class="pricing-invest">
          <p>
            Most clients invest <strong>$2,500-$4,000 one-time</strong> for setup
            per business, and <strong>from $500/month per location</strong> for ongoing
            AI call handling and support.
          </p>
          <p class="pricing-invest-note">
            Exact pricing depends on call volume, number of locations, and integrations.
          </p>
        </div>
      </div>

      <div class="pricing-card pricing-card-featured">
        <span class="pricing-badge">Advanced</span>
        <h3 class="pricing-name">AI Call Ops Assistant</h3>
        <p class="pricing-ideal">
          Teams that want every call summarized and turned into concrete next actions
          inside the CRM.
        </p>
        <ul class="pricing-includes">
          <li><span class="check">&#10003;</span><span>Ingests every inbound and outbound call through your Twilio / business line</span></li>
          <li><span class="check">&#10003;</span><span>Reads the transcript and pulls full CRM history for context</span></li>
          <li><span class="check">&#10003;</span><span>Auto-writes call summaries and updates notes / opportunities</span></li>
          <li><span class="check">&#10003;</span><span>Creates follow-up tasks so promises made on calls actually happen</span></li>
        </ul>
        <div class="pricing-invest">
          <p>
            Full call ops automation projects typically start at
            <strong>$3,000-$5,000 for implementation</strong>, plus an ongoing fee
            based on call volume and CRM complexity.
          </p>
          <p class="pricing-invest-note">
            We'll quote this only if it's clearly ROI-positive for your team.
          </p>
        </div>
      </div>
    </div>

    <p class="pricing-footer-note">
      On your 15-minute fit call, we'll map your call flow, estimate ROI vs a human
      receptionist or VA, and give you a clear price for your setup. If it's not a fit,
      we'll tell you.
    </p>
  </section>

  <!-- ===== 7. SOCIAL PROOF ===== -->
  <!-- Hidden until we have real testimonials. Restore by uncommenting. -->
  <!--
  <section class="proof-section">
    <div class="proof-inner container">
      <div class="proof-card">
        <div class="quote-icon">&ldquo;</div>
        <p class="quote-text">
          As soon as we turned it on, we stopped missing calls and started seeing
          more booked jobs from leads we'd forgotten about. It paid for itself in
          the first week.
        </p>
        <p class="quote-author">
          <strong>- Client Name</strong>, Company (Placeholder)
        </p>
      </div>

      <div class="proof-card metrics-card">
        <h3>What clients see after turning on VoiceCloser</h3>
        <div class="metric-row">
          <span class="metric-number">0</span>
